{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  // Versions in build scripts, marked with a comment on the line above:
  //   # renovate: datasource=github-releases depName=owner/repo
  //   SOME_VERSION="v1.2.3"
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/.+\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=\"?(?<currentValue>[^\"\\s]+)\"?",
      ],
    },
  ],

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    // Keep the base image on its moving tag. ublue rebuilds it about daily
    // and the weekly build picks up the latest; pinning it would mean a
    // digest-bump PR every day. Major bumps (e.g. 45 -> 46) still get a PR.
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ublue-os/silverblue-main"],
      "pinDigests": false
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ]
}
