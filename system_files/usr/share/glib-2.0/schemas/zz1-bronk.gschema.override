# bronk's GNOME defaults. "zz1-" sorts after the base image's overrides, so these win.
# They only apply to users who haven't changed the setting themselves.

# bronk logo at the bottom of the login screen (IVA-65)
[org.gnome.login-screen]
logo='/usr/share/pixmaps/bronk-gdm-logo.png'

# Default wallpaper: Terminal grid, light and dark (IVA-68). All 7 designs are
# listed in Settings > Appearance via gnome-background-properties/bronk.xml.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/bronk/bronk-terminal-grid-light.png'
picture-uri-dark='file:///usr/share/backgrounds/bronk/bronk-terminal-grid-dark.png'
picture-options='zoom'
primary-color='#0d0d0d'

# Lock screen
[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/bronk/bronk-terminal-grid-dark.png'
picture-options='zoom'
primary-color='#0d0d0d'

# Accent color (IVA-72). GNOME only takes named accents; orange is the
# closest to the brand orange (#ff6a00).
[org.gnome.desktop.interface]
accent-color='orange'

# Keyboard shortcuts (IVA-72). The custom ones (terminal, Resources) are in
# /etc/dconf/db/local.d/20-bronk-keybindings: a gschema override can't set them.
[org.gnome.desktop.wm.keybindings]
close=['<Super>q']
cycle-windows=['<Alt>Tab']
cycle-windows-backward=['<Shift><Alt>Tab']
switch-applications=@as []
switch-applications-backward=@as []
toggle-fullscreen=['<Super>f']
toggle-maximized=['<Shift><Super>f']

[org.gnome.settings-daemon.plugins.media-keys]
screensaver=['<Shift><Super>l']
www=['<Super>b']
