// System-wide fastfetch config for bronk (IVA-65).
// A config in ~/.config/fastfetch/ replaces this one entirely.
// "modules" is fastfetch's default list (fastfetch --gen-config); a config
// without it shows only the logo.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/bronk/fastfetch-logo.txt",
    // $1 = ink #f5f5f0, $2 = accent #ff6a00 (branding/README.md)
    "color": {
      "1": "38;2;245;245;240",
      "2": "38;2;255;106;0"
    },
    "padding": { "top": 2, "left": 2, "right": 4 }
  },
  "display": {
    "color": {
      "keys": "38;2;255;106;0",
      "title": "38;2;255;106;0"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
