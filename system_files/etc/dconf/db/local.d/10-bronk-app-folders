# Default app-grid folders (IVA-67). Compiled into /etc/dconf/db/local by
# `dconf update` in build_files/launcher.sh. Apps not listed stay on the
# main grid. Rearranging apps by hand overrides this for that user.

[org/gnome/desktop/app-folders]
folder-children=['Utilities', 'System', 'Tweaks']

[org/gnome/desktop/app-folders/folders/Utilities]
name='Utilities'
apps=['org.gnome.Calculator.desktop', 'org.gnome.clocks.desktop', 'org.gnome.Weather.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.Papers.desktop']

[org/gnome/desktop/app-folders/folders/System]
name='System'
apps=['net.nokyan.Resources.desktop', 'org.gnome.DiskUtility.desktop', 'org.gnome.baobab.desktop', 'org.gnome.Logs.desktop', 'org.fedoraproject.MediaWriter.desktop', 'io.github.v81d.Wattage.desktop']

[org/gnome/desktop/app-folders/folders/Tweaks]
name='Tweaks'
apps=['com.mattjakeman.ExtensionManager.desktop', 'com.github.tchx84.Flatseal.desktop']
